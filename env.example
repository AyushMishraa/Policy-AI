# ── Gemini ─────────────────────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Free-tier models (no billing card required):
#   gemini-2.0-flash        ← recommended (fast, generous free quota)
#   gemini-1.5-flash        ← alternative
#   gemini-1.5-flash-8b     ← smallest / fastest
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_GEN=gemini-2.0-flash

# ── Qdrant ─────────────────────────────────────────────────────────────────
# Run locally with Docker:  docker compose up qdrant -d
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                    # leave empty for local Docker (no auth)
QDRANT_COLLECTION=company_policies

# ── Embeddings ─────────────────────────────────────────────────────────────
# sentence-transformers model — runs fully locally, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_SIZE=384                    # must match the chosen embedding model:
#   all-MiniLM-L6-v2       → 384
#   all-mpnet-base-v2       → 768
#   multi-qa-MiniLM-L6-cos-v1 → 384

# ── Server ─────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
MAX_WORKERS=5
QUEUE_MAX_SIZE=100

# ── RAG ────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_RELEVANCE=0.25

# ── Voice ──────────────────────────────────────────────────────────────────
# Whisper model sizes: tiny | base | small | medium | large
WHISPER_MODEL=base
TTS_ENABLED=true
TTS_VOICE_RATE=175

# ── Paths ──────────────────────────────────────────────────────────────────
POLICIES_DIR=./policies

# ── Database ingestion (optional) ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DATABASE_URL=sqlite:///./policies.db
